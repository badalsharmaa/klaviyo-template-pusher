# =========================================================
# Klaviyo Template Pusher - Environment Configuration
# =========================================================
# 1. Duplicate this file and rename it to `.env`
# 2. Add your Klaviyo Private API Key below.
#
# IMPORTANT: Never commit your `.env` file to version control.
# =========================================================

# Klaviyo Private API Key (format: pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx)
KLAVIYO_API_KEY=your_klaviyo_private_api_key_here

# Optional: Default API Revision (default: 2026-04-15)
KLAVIYO_API_REVISION=2026-04-15
